{
  "name": "orun-qa-policy-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  // Free plan caps a Worker at 3MB gzipped (10MB on paid) — minify fleet-wide
  // so the ceiling is never the thing that blocks a deploy.
  "minify": true,
  "vars": {
    "ENVIRONMENT": "local"
  },
  "env": {
    "dev": {
      "vars": { "ENVIRONMENT": "dev" }
    },
    "stage": {
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "stage" }
    },
    "prod": {
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "prod" }
    }
  }
}
