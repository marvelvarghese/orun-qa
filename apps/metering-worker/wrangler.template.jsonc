// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from AWS Secrets Manager at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "orun-qa-metering-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  // Free plan caps a Worker at 3MB gzipped (10MB on paid) — minify fleet-wide
  // so the ceiling is never the thing that blocks a deploy.
  "minify": true,
  "vars": {
    "ENVIRONMENT": "local"
  },
  // Cron budget (free plan: 5 triggers per ACCOUNT, across every worker AND
  // every environment). Triggers are declared per-environment, in `prod` only:
  // a top-level `triggers` block is inherited by stage and prod alike, which is
  // what put this account at 6/5. See specs/profiles/free-tier.md.
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage"
      },
      "hyperdrive": [
        {
          "binding": "PLATFORM_DB",
          "id": "@@wiring(cloudflare-hyperdrive/stage:hyperdrive_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "orun-qa-membership-worker-stage"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "orun-qa-policy-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      // Usage rollup materialization, hourly at :05.
      "triggers": {
        "crons": ["5 * * * *"]
      },
      "vars": {
        "ENVIRONMENT": "prod"
      },
      "hyperdrive": [
        {
          "binding": "PLATFORM_DB",
          "id": "@@wiring(cloudflare-hyperdrive/prod:hyperdrive_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "orun-qa-membership-worker-prod"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "orun-qa-policy-worker-prod"
        }
      ]
    }
  }
}
